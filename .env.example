# 本地 Postgres 连接串（不写密码，走本机 peer/trust 认证）
DATABASE_URL=postgres://localhost:5432/nine_grid

# 监听地址；8080 被占用时换一个
BIND_ADDR=127.0.0.1:8080

# 静态文件目录，默认取 crates/server/static
# STATIC_DIR=/absolute/path/to/static

# 每个 IP 每分钟允许的写请求数（建局 / 入座 / 落子 / 请机器人）；
# 0 = 关闭限流。默认 300，正常下一局用不到十分之一。
# RATE_LIMIT_PER_MIN=300
