  "types": [
    {
      "name": "Game",
      "docs": [
        "一局九宫棋的完整链上状态。",
        "",
        "所有字段都是定长的，所以空间可以在编译期算出来（`Game::INIT_SPACE`），",
        "不需要 `realloc`。账户布局 101 字节，与冻结版完全一致 —— 老账户可直接读。"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "player_o",
            "docs": [
              "创建者 / O 方，租金由它支付"
            ],
            "type": "pubkey"
          },
          {
            "name": "player_x",
            "docs": [
              "X 方，加入前是 `Pubkey::default()`"
            ],
            "type": "pubkey"
          },
          {
            "name": "board",
            "docs": [
              "9 个格子：0 空 / 1 O / 2 X"
            ],
            "type": {
              "array": [
                "u8",
                9
              ]
            }
          },
          {
            "name": "turn",
            "docs": [
              "当前该谁落子（MARK_O / MARK_X）"
            ],
            "type": "u8"
          },
          {
            "name": "state",
            "docs": [
              "对局状态"
            ],
            "type": {
              "defined": {
                "name": "GameState"
              }
            }
          },
          {
            "name": "game_id",
            "docs": [
