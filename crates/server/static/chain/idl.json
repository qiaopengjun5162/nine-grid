  "types": [
    {
      "name": "Game",
      "docs": [
        "一局九宫棋的完整链上状态。",
        "",
        "所有字段都是定长的，所以空间可以在编译期算出来（`Game::INIT_SPACE`），",
        "不需要 `realloc`。账户布局 101 字节，与冻结版完全一致 —— 老账户可直接读。"
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "player_o",
            "docs": [
              "创建者 / O 方，租金由它支付"
            ],
            "type": "pubkey"
          },
          {
            "name": "player_x",
            "docs": [
              "X 方，加入前是 `Pubkey::default()`"
            ],
            "type": "pubkey"
          },
          {
            "name": "board",
            "docs": [
              "9 个格子：0 空 / 1 O / 2 X"
            ],
            "type": {
              "array": [
                "u8",
                9
              ]
            }
          },
          {
            "name": "turn",
            "docs": [
              "当前该谁落子（MARK_O / MARK_X）"
            ],
            "type": "u8"
          },
          {
            "name": "state",
            "docs": [
              "对局状态"
            ],
            "type": {
              "defined": {
                "name": "GameState"
              }
            }
          },
          {
            "name": "game_id",
            "docs": [
              "客户端传入的对局编号，配合 player_o 派生出唯一地址"
            ],
            "type": "u64"
          },
          {
            "name": "moves",
            "docs": [
              "已落子数量，等于 9 且无胜者即为平局"
            ],
            "type": "u8"
          },
          {
            "name": "last_activity_at",
            "docs": [
              "最后一次活动时间（链上时钟，秒）：建局、入座、落子都会刷新。",
              "",
              "这个字段原本叫 `created_at`（只在建局时写一次）。为了在不改账户布局、",
              "不迁移老账户的前提下支持超时判定，改成「最后活动时间」语义 ——",
              "字节位置和类型都没变，老账户仍能正确反序列化（值是创建时间，",
              "对超时而言只会更早触发，不会漏判）。"
            ],
            "type": "i64"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump，保存下来省掉后续重复计算"
            ],
            "type": "u8"
          }
        ]
      }
    },
